# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Real accounts: set to "cloudflare" to use the Cloudflare database and email sign-in below. Leave it unset
# for demo mode (everything saved in this browser only, no sign-in). Not a secret: it only switches the mode.
# NEXT_PUBLIC_DATA_BACKEND=cloudflare

# Claude API key from console.anthropic.com -> API keys. Server-only: never prefix it with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=your-claude-api-key

# Google Gemini via OpenRouter (openrouter.ai -> Keys). Server-only: never prefix it with NEXT_PUBLIC_.
# Requests go only to OpenRouter and are pinned to Google's endpoints (google-vertex, google-ai-studio).
OPENROUTER_API_KEY=

# Which AI to use: anthropic, gemini, mock or off. Leave unset for the default
# (Claude if ANTHROPIC_API_KEY is real, else Gemini if OPENROUTER_API_KEY is real, else the free mock).
# AI_PROVIDER=gemini

# Optional model overrides. Only Google models (IDs starting "google/") are accepted; anything else
# falls back to the default. Defaults: google/gemini-3.7-flash (box reading), google/gemini-3.5-flash-lite (categories).
# OPENROUTER_MODEL=google/gemini-3.7-flash
# OPENROUTER_CATEGORY_MODEL=google/gemini-3.5-flash-lite
# Promotional circular (also Google-only): AI copywriter (default google/gemini-3.7-flash) and
# AI supporting visuals only (default google/gemini-3.1-flash-image).
# Packaging is assembled locally from original photos; it is never AI-redrawn.
# OPENROUTER_COPY_MODEL=google/gemini-3.7-flash
# OPENROUTER_IMAGE_MODEL=google/gemini-3.1-flash-image

# Cloudflare D1 (database) and R2 (photos), reached from Vercel over Cloudflare's API. All server-only.
# Account ID: Cloudflare dashboard -> Account home (right-hand side, "Account ID").
# CLOUDFLARE_ACCOUNT_ID=
# D1 database ID: Storage & databases -> D1 -> your database -> "Database ID".
# CLOUDFLARE_D1_DATABASE_ID=
# API token with Account -> D1 -> Edit only: My Profile -> API Tokens -> Create Token -> Custom token.
# CLOUDFLARE_D1_API_TOKEN=
# R2 bucket name and its S3 keys (R2 -> Overview -> API Tokens: Manage -> Object Read & Write, this bucket only).
# R2_BUCKET=dawakraft-media
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=

# Email-code sign-in. Resend (resend.com -> API Keys, "Sending access"). Without a verified domain, Resend only
# delivers to your own account email; use "Dawakraft <onboarding@resend.dev>" as the sender until then.
# RESEND_API_KEY=
# AUTH_EMAIL_FROM=Dawakraft <onboarding@resend.dev>
# A long random secret for sign-in codes (at least 32 characters; generate one with the command in the README).
# Without a real RESEND_API_KEY, `npm run dev` prints the code to the terminal instead (never in production).
# AUTH_SECRET=

# Online demo passcode (server-only; never prefix with NEXT_PUBLIC_). While there is no login, visitors who
# enter this passcode can use the paid AI for 12 hours (tight per-IP limits). Leave unset to keep it off.
# Changing it signs everyone out of the unlock. Delete it once sign-in exists.
# DEMO_PASSCODE=
