# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Supabase: Project Settings -> API (or "Connect"). The publishable key (or the older "anon" key) is safe in the browser
# because row-level security protects every row.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Claude API key from console.anthropic.com -> API keys. Server-only: never prefix it with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=your-claude-api-key

# Google Gemini via OpenRouter (openrouter.ai -> Keys). Server-only: never prefix it with NEXT_PUBLIC_.
# Requests go only to OpenRouter and are pinned to Google's endpoints (google-vertex, google-ai-studio).
OPENROUTER_API_KEY=

# Which AI to use: anthropic, gemini, mock or off. Leave unset for the default
# (Claude if ANTHROPIC_API_KEY is real, else Gemini if OPENROUTER_API_KEY is real, else the free mock).
# AI_PROVIDER=gemini

# Optional model overrides. Only Google models (IDs starting "google/") are accepted; anything else
# falls back to the default. Defaults: google/gemini-3.7-flash (box reading), google/gemini-3.5-flash-lite (categories).
# OPENROUTER_MODEL=google/gemini-3.7-flash
# OPENROUTER_CATEGORY_MODEL=google/gemini-3.5-flash-lite

# Online demo passcode (server-only; never prefix with NEXT_PUBLIC_). While there is no login, visitors who
# enter this passcode can use the paid AI for 12 hours (tight per-IP limits). Leave unset to keep it off.
# Changing it signs everyone out of the unlock. Delete it once sign-in exists.
# DEMO_PASSCODE=
